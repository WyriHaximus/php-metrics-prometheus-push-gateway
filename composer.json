{
  "name": "wyrihaximus/metrics-prometheus-push-gateway",
  "description": "\ud83d\udd75\ufe0f\u200d\u2640\ufe0f Prometheus modelled metric VO's and registry",
  "license": "MIT",
  "authors": [
    {
      "name": "Cees-Jan Kiewiet",
      "email": "ceesjank@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "nyholm/psr7": "^1.8",
    "psr/http-client": "^1",
    "psr/http-client-implementation": "^1",
    "wyrihaximus/metrics": "^3.0"
  },
  "require-dev": {
    "php-http/mock-client": "^1.6",
    "wyrihaximus/makefiles": "^0.13.2",
    "wyrihaximus/test-utilities": "^13.4.0"
  },
  "autoload": {
    "psr-4": {
      "WyriHaximus\\Metrics\\PrometheusPushGateway\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WyriHaximus\\Tests\\Metrics\\PrometheusPushGateway\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "icanhazstring/composer-unused": true,
      "infection/extension-installer": true,
      "php-http/discovery": true,
      "phpstan/extension-installer": true,
      "wyrihaximus/makefiles": true,
      "wyrihaximus/test-utilities": true
    },
    "platform": {
      "php": "8.4.13"
    },
    "sort-packages": true
  },
  "scripts": {
    "post-install-cmd": [
      "make on-install-or-update || true"
    ],
    "post-update-cmd": [
      "make on-install-or-update || true"
    ]
  }
}
